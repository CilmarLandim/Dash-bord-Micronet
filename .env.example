# Motor de IA (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# HeyGen (Avatar de Vídeo)
HEYGEN_API_KEY=sk_V2_sua_chave_aqui

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=seu_sid_aqui
TWILIO_AUTH_TOKEN=seu_token_aqui
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


# Banco de Dados SQLite
DB_PATH=./data/micronet.db

# Servidor
PORT=3001
NODE_ENV=development

# Integração com LAN (Opcional)
LAN_SERVER_URL=http://192.168.1.100:8080
LAN_SHARED_FOLDER=/documentos
LAN_USERNAME=admin
LAN_PASSWORD=password

# Impressora (Opcional)
PRINTER_NAME=Impressora Micronet
PRINTER_ADDRESS=192.168.1.50

# Micronet Info
MICRONET_NAME=Micronet
MICRONET_PHONE=(11) 3000-0000
MICRONET_EMAIL=contato@micronet.com.br
MICRONET_ADDRESS=Rua Principal, 123 - São Paulo, SP
